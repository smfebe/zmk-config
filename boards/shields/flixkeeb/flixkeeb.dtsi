#include <dt-bindings/zmk/matrix_transform.h> // Put this with the other includes at the top of your dtsi

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        
        col-gpios
            = <&gpio0 3 GPIO_ACTIVE_HIGH>
            , <&gpio0 19 GPIO_ACTIVE_HIGH>
            , <&gpio0 28 GPIO_ACTIVE_HIGH>
            , <&gpio1 1 GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio0 9 GPIO_ACTIVE_HIGH>
            ;

    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
        //  LINKS: außen -> innen (col 0..5)                          RECHTS: innen -> außen (col 5..0, global 11..6)
        //  Zeile 0 (Positionen 0-11)
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)     RC(0,11)  RC(0,10)  RC(0,9)  RC(0,8)  RC(0,7)  RC(0,6)

        //  Zeile 1 (Positionen 12-23)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)     RC(1,11)  RC(1,10)  RC(1,9)  RC(1,8)  RC(1,7)  RC(1,6)

        //  Zeile 2 (Positionen 24-35)
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)     RC(2,11)  RC(2,10)  RC(2,9)  RC(2,8)  RC(2,7)  RC(2,6)

        //  Zeile 3 (Positionen 36-47)
            RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)     RC(3,11)  RC(3,10)  RC(3,9)  RC(3,8)  RC(3,7)  RC(3,6)

        //  Zeile 4 (Positionen 48-53): nur Daumencluster, jeweils die 3 inneren Spalten
                            RC(4,3)  RC(4,4)  RC(4,5)             RC(4,11)  RC(4,10)  RC(4,9)
        >;
    };
};