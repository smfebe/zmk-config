#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// ---------------------------------------------------------------------------
// Layer-Indizes: neue Layer immer hinten anhaengen
// ---------------------------------------------------------------------------
#define BASE  0
#define LOWER 1
#define RAISE 2

// ---------------------------------------------------------------------------
// Deutsche Belegung: ZMK sendet US-Tastenpositionen, der Rechner steht auf DE
// ---------------------------------------------------------------------------
// Buchstaben, die auf DE vertauscht sind
#define DE_Y      Z
#define DE_Z      Y

// Symbole
#define DE_EXCL   LS(N1)      // !
#define DE_DQT    LS(N2)      // "
#define DE_DLLR   LS(N4)      // $
#define DE_PRCNT  LS(N5)      // %
#define DE_AMPS   LS(N6)      // &
#define DE_SLASH  LS(N7)      // /
#define DE_LPAR   LS(N8)      // (
#define DE_RPAR   LS(N9)      // )
#define DE_EQUAL  LS(N0)      // =
#define DE_QMARK  LS(MINUS)   // ?
#define DE_AT     RA(Q)       // @
#define DE_HASH   BSLH        // #
#define DE_PLUS   RBKT        // +
#define DE_ASTRK  LS(RBKT)    // *
#define DE_TILDE  RA(RBKT)    // ~
#define DE_LBKT   RA(N8)      // [
#define DE_RBKT   RA(N9)      // ]
#define DE_LBRC   RA(N7)      // {
#define DE_RBRC   RA(N0)      // }
#define DE_BSLH   RA(MINUS)   // backslash
#define DE_MINUS  FSLH        // -
#define DE_UNDER  LS(FSLH)    // _
#define DE_SEMI   LS(COMMA)   // ;
#define DE_COLON  LS(DOT)     // :
#define DE_SQT    LS(BSLH)    // '
#define DE_LT     NUBS        // <
#define DE_GT     LS(NUBS)    // >
#define DE_PIPE   RA(NUBS)    // |
#define DE_CARET  GRAVE       // ^ (Tottaste)

// Umlaute und ss
#define DE_UUML   LBKT        // ue
#define DE_OUML   SEMI        // oe
#define DE_AUML   SQT         // ae
#define DE_SS     MINUS       // ss

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
// ------------------------------------------------------------------------------------
// | ESC  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  ss  |
// | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Z  |  U  |  I  |  O  |  P  | BSPC |
// | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | CTRL |  Y  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  -  |  /   |
//                    | GUI | LWR | SPC |   | ENT | RSE | BSPC |
            bindings = <
   &kp ESC   &kp N1    &kp N2 &kp N3 &kp N4 &kp N5     &kp N6    &kp N7 &kp N8    &kp N9  &kp N0       &kp DE_SS
   &kp TAB   &kp Q     &kp W  &kp E  &kp R  &kp T      &kp DE_Z  &kp U  &kp I     &kp O   &kp P        &kp BSPC
   &kp LSHFT &kp A     &kp S  &kp D  &kp F  &kp G      &kp H     &kp J  &kp K     &kp L   &kp DE_SEMI  &kp DE_SQT
   &kp LCTRL &kp DE_Y  &kp X  &kp C  &kp V  &kp B      &kp N     &kp M  &kp COMMA &kp DOT &kp DE_MINUS &kp DE_SLASH
                              &kp LGUI &mo LOWER &kp SPACE   &kp RET &mo RAISE &kp BSPC
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "Lower";
// ------------------------------------------------------------------------------------
// | F1   | F2  | F3  | F4  | F5  | F6  |   | F7  | F8  | F9  | F10  | F11 | F12 |
// |   @  |  [  |  ]  |  <  |  >  |     |   |  7  |  8  |  9  |  /  |  *  |      |
// |      |  (  |  )  |  {  |  }  |  #  |   |  4  |  5  |  6  |  -  |  +  |      |
// |      |     |  \  |  |  |  /  |     |   |  1  |  2  |  3  |  0  |  ,  |  =   |
            bindings = <
   &kp F1       &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10       &kp F11       &kp F12
   &kp DE_AT    &kp DE_LBKT     &kp DE_RBKT     &kp DE_LT       &kp DE_GT       &trans          &kp N7          &kp N8          &kp N9          &kp DE_SLASH &kp DE_ASTRK  &trans
   &trans       &kp DE_LPAR     &kp DE_RPAR     &kp DE_LBRC     &kp DE_RBRC     &kp DE_HASH     &kp N4          &kp N5          &kp N6          &kp DE_MINUS &kp DE_PLUS   &trans
   &trans       &trans          &kp DE_BSLH     &kp DE_PIPE     &kp DE_SLASH    &trans          &kp N1          &kp N2          &kp N3          &kp N0       &kp COMMA     &kp DE_EQUAL
                                                &trans          &trans          &trans          &trans          &trans          &kp DEL
            >;
        };

        raise_layer {
            display-name = "Raise";
// ------------------------------------------------------------------------------------
// |      | BT1 | BT2 | BT3 | BT4 | BT5 |   | USB | BLE | TOG |     |     |      |
// |      | RGB | EFF | BRI | BRD |     |   |     |  ue |     |  oe |     |      |
// |      |  ae |     |     | HUE | SAT |   |  <- |  v  |  ^  |  -> |     |      |
// |      | UNLK|     |     |     |     |   |     |     |     |     |     | BTCLR|
            bindings = <
   &trans &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &out OUT_USB &out OUT_BLE &out OUT_TOG &trans &trans &trans
   &trans &rgb_ug RGB_TOG  &rgb_ug RGB_EFF &rgb_ug RGB_BRI &rgb_ug RGB_BRD &trans         &trans       &kp DE_UUML  &trans       &kp DE_OUML &trans &trans
   &trans &kp DE_AUML      &trans          &trans          &rgb_ug RGB_HUI &rgb_ug RGB_SAI &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT &trans &trans
   &trans &studio_unlock   &trans          &trans          &trans          &trans          &trans       &trans       &trans       &trans   &trans &bt BT_CLR
                                   &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};