#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// ---------------------------------------------------------------------------
// Layer-Indizes: neue Layer immer hinten anhaengen
// ---------------------------------------------------------------------------
#define BASE   0
#define LOWER  1
#define RAISE  2
#define SYSTEM 3

// ---------------------------------------------------------------------------
// Deutsche Belegung: ZMK sendet US-Tastenpositionen, der Rechner steht auf DE
// ---------------------------------------------------------------------------
// Hinweis: keymap-drawer definiert KEYMAP_DRAWER. Dann bleiben die DE_*-Namen
// unaufgeloest und werden ueber zmk_keycode_map in keymap_drawer.config.yaml
// als Zeichen dargestellt. Beim echten Firmware-Build ist das Makro nicht definiert.
#ifndef KEYMAP_DRAWER
// Buchstaben, die auf DE vertauscht sind
#define DE_Y      Z
#define DE_Z      Y

// Symbole
#define DE_EXCL   LS(N1)      // !
#define DE_DQT    LS(N2)      // "
#define DE_DLLR   LS(N4)      // $
#define DE_PRCNT  LS(N5)      // %
#define DE_AMPS   LS(N6)      // &
#define DE_SLASH  LS(N7)      // /
#define DE_LPAR   LS(N8)      // (
#define DE_RPAR   LS(N9)      // )
#define DE_EQUAL  LS(N0)      // =
#define DE_QMARK  LS(MINUS)   // ?
#define DE_AT     RA(Q)       // @
#define DE_EURO   RA(E)       // euro
#define DE_MU     RA(M)       // my (mikro)
#define DE_SUP2   RA(N2)      // hoch 2
#define DE_SUP3   RA(N3)      // hoch 3
#define DE_HASH   BSLH        // #  (mit Shift: ')
#define DE_PLUS   RBKT        // +  (mit Shift: *)
#define DE_ASTRK  LS(RBKT)    // *
#define DE_TILDE  RA(RBKT)    // ~
#define DE_LBKT   RA(N8)      // [
#define DE_RBKT   RA(N9)      // ]
#define DE_LBRC   RA(N7)      // {
#define DE_RBRC   RA(N0)      // }
#define DE_BSLH   RA(MINUS)   // backslash
#define DE_MINUS  FSLH        // -
#define DE_UNDER  LS(FSLH)    // _
#define DE_SEMI   LS(COMMA)   // ;
#define DE_COLON  LS(DOT)     // :
#define DE_SQT    LS(BSLH)    // '
#define DE_LT     NUBS        // <
#define DE_GT     LS(NUBS)    // >
#define DE_PIPE   RA(NUBS)    // |
#define DE_CARET  GRAVE       // ^  (mit Shift: Grad-Zeichen) - Tottaste
#define DE_ACUTE  EQUAL       // ´  (mit Shift: Backtick)     - Tottaste

// Umlaute und ss
#define DE_UUML   LBKT        // ue
#define DE_OUML   SEMI        // oe
#define DE_AUML   SQT         // ae
#define DE_SS     MINUS       // ss
#endif // KEYMAP_DRAWER

/ {
    // -----------------------------------------------------------------------
    // Combos (nur auf dem Base-Layer). Positionen = Index in der Map (0-53):
    //   Zeile 0: 0-11   Zeile 1: 12-23   Zeile 2: 24-35   Zeile 3: 36-47
    //   Daumen links (aussen -> innen): 48 49 50
    //   Daumen rechts (innen -> aussen): 51 52 53
    // -----------------------------------------------------------------------
    combos {
        compatible = "zmk,combos";

        // --- Umlaute und ss: senkrechte Paare auf demselben Finger ---------
        combo_auml {                      // Q + A  ->  ae
            timeout-ms = <40>;
            key-positions = <13 25>;
            bindings = <&kp DE_AUML>;
            layers = <BASE>;
        };
        combo_ouml {                      // O + L  ->  oe
            timeout-ms = <40>;
            key-positions = <21 33>;
            bindings = <&kp DE_OUML>;
            layers = <BASE>;
        };
        combo_uuml {                      // U + J  ->  ue
            timeout-ms = <40>;
            key-positions = <19 31>;
            bindings = <&kp DE_UUML>;
            layers = <BASE>;
        };
        combo_ss {                        // S + X  ->  ss
            timeout-ms = <40>;
            key-positions = <26 38>;
            bindings = <&kp DE_SS>;
            layers = <BASE>;
        };

        // --- Caps Word: beide Shift-Tasten gleichzeitig --------------------
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <24 35>;
            bindings = <&caps_word>;
            layers = <BASE>;
        };

        // --- Layer per Daumen-Combo ----------------------------------------
        combo_lower {                     // links: Space + Alt  -> Lower
            timeout-ms = <30>;
            key-positions = <49 50>;
            bindings = <&mo LOWER>;
            layers = <BASE>;
        };
        combo_raise {                     // rechts: Enter + Space -> Raise
            timeout-ms = <30>;
            key-positions = <51 52>;
            bindings = <&mo RAISE>;
            layers = <BASE>;
        };
        combo_system {                    // beide Space-Tasten -> System
            timeout-ms = <30>;
            key-positions = <49 52>;
            bindings = <&mo SYSTEM>;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
// ------------------------------------------------------------------------------------
// | ESC  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Z  |  U  |  I  |  O  |  P  | ENT  |
// | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  | SHFT |
// | CTRL |  Y  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  -  | CTRL |
//                    | GUI | SPC | ALT |   | ENT | SPC | BSPC |
// Combos: Q+A=ae  O+L=oe  U+J=ue  S+X=ss  SHFT+SHFT=CapsWord
//         SPC+ALT=Lower  ENT+SPC=Raise  SPC+SPC=System
            bindings = <
   &kp ESC   &kp N1    &kp N2 &kp N3 &kp N4 &kp N5     &kp N6    &kp N7 &kp N8    &kp N9  &kp N0       &kp BSPC
   &kp TAB   &kp Q     &kp W  &kp E  &kp R  &kp T      &kp DE_Z  &kp U  &kp I     &kp O   &kp P        &kp RET
   &kp LSHFT &kp A     &kp S  &kp D  &kp F  &kp G      &kp H     &kp J  &kp K     &kp L   &kp DE_SEMI  &kp RSHFT
   &kp LCTRL &kp DE_Y  &kp X  &kp C  &kp V  &kp B      &kp N     &kp M  &kp COMMA &kp DOT &kp DE_MINUS &kp RCTRL
                              &kp LGUI &kp SPACE &kp LALT   &kp RET &kp SPACE &kp BSPC
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "Lower";
// ------------------------------------------------------------------------------------
// | F1   | F2  | F3  | F4  | F5  | F6  |   | F7  | F8  | F9  | F10  | F11 | F12 |
// |      |  @  |  \  | EUR |  |  |  ~  |   |  7  |  8  |  9  |  /  |  *  |     |
// |      |  (  |  )  |  {  |  }  |  #  |   |  4  |  5  |  6  |  -  |  +  |     |
// |      |  [  |  ]  |  <  |  >  |  '  |   |  1  |  2  |  3  |  0  |  ,  |  ?  |
//                                                         (rechter Daumen aussen: DEL)
            bindings = <
   &kp F1       &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10       &kp F11       &kp F12
   &trans       &kp DE_AT       &kp DE_BSLH     &kp DE_EURO     &kp DE_PIPE     &kp DE_TILDE    &kp N7          &kp N8          &kp N9          &kp DE_SLASH &kp DE_ASTRK  &trans
   &trans       &kp DE_LPAR     &kp DE_RPAR     &kp DE_LBRC     &kp DE_RBRC     &kp DE_HASH     &kp N4          &kp N5          &kp N6          &kp DE_MINUS &kp DE_PLUS   &trans
   &trans       &kp DE_LBKT     &kp DE_RBKT     &kp DE_LT       &kp DE_GT       &kp DE_SQT      &kp N1          &kp N2          &kp N3          &kp N0       &kp COMMA     &kp DE_QMARK
                                                &trans          &trans          &trans          &trans          &trans          &kp DEL
            >;
        };

        raise_layer {
            display-name = "Raise";
// ------------------------------------------------------------------------------------
// |  ^   |     |  2  |  3  |     |     |   |     |     |     |     |     |  '   |
// |      |     |     |     |     |     |   |HOME |PG_UP|PG_DN| END |     |      |
// |      |     |     |     |     |     |   |  <- |  v  |  ^  |  -> |     |      |
// |      |     |     |     |     |     |   |     |  my |PLAY |MUTE |PRINT|      |
// ^ mit Shift = Grad-Zeichen, ' (Akzent) mit Shift = Backtick, 2/3 = hoch 2/hoch 3
            bindings = <
   &kp DE_CARET &trans  &kp DE_SUP2 &kp DE_SUP3 &trans &trans     &trans &trans  &trans  &trans  &trans  &kp DE_ACUTE
   &trans       &trans  &trans      &trans      &trans &trans     &kp HOME &kp PG_UP &kp PG_DN &kp END &trans &trans
   &trans       &trans  &trans      &trans      &trans &trans     &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &trans &trans
   &trans       &trans  &trans      &trans      &trans &trans     &trans &kp DE_MU &kp C_PP &kp C_MUTE &kp PSCRN &trans
                              &trans &trans &trans   &trans &trans &trans
            >;
        };

        system_layer {
            display-name = "System";
// ------------------------------------------------------------------------------------
// Aktiv, solange beide Space-Daumentasten gehalten werden.
// |      | BT1 | BT2 | BT3 | BT4 | BT5 |   | USB | BLE | TOG |     |     |      |
// |      | RGB | EFF | BRI | BRD |     |   |     |     |     |     |     |      |
// |      |     |     |     | HUE | SAT |   |     |     |     |     |     |      |
// |      | UNLK|     |     |     |     |   |     |     |     |     |     | BTCLR|
            bindings = <
   &none &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &out OUT_USB &out OUT_BLE &out OUT_TOG &none &none &none
   &none &rgb_ug RGB_TOG  &rgb_ug RGB_EFF &rgb_ug RGB_BRI &rgb_ug RGB_BRD &none           &none        &none        &none        &none &none &none
   &none &none            &none           &none           &rgb_ug RGB_HUI &rgb_ug RGB_SAI &none        &none        &none        &none &none &none
   &none &studio_unlock   &none           &none           &none           &none           &none        &none        &none        &none &none &bt BT_CLR
                                   &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};